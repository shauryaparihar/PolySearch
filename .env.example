# Copy to .env (gitignored). Placeholders only; never commit real values.
# The API refuses to start while a secret still contains CHANGE_ME. With ENVIRONMENT=production
# it also requires CURSOR_SECRET (and ADMIN_API_KEY, if set) to be at least 32 characters, a
# non-development database password, a non-localhost CORS origin and an artifact location.
# Generate secrets with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://polysearch:CHANGE_ME@localhost:5433/polysearch_dev
TEST_DATABASE_URL=postgresql+psycopg://polysearch:CHANGE_ME@localhost:5433/polysearch_test
WIKIPEDIA_USER_AGENT=PolySearch/0.1 (https://example.invalid/contact; you@example.invalid)
MAX_PAGES_PER_JOB=200

# Search API (run from backend/: uvicorn app.main:create_app --factory)
ACTIVE_INDEX_PATH=../artifacts/index/idx-REPLACE_WITH_VERSION
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
CURSOR_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
SEARCH_RATE_LIMIT_PER_MINUTE=30
TRUSTED_PROXY_IPS=[]
ANALYTICS_STORE_QUERY_TEXT=false

# Phase 5: product signals. Leave ADMIN_API_KEY unset to disable the admin API entirely.
ADMIN_API_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
SUGGEST_RATE_LIMIT_PER_MINUTE=120
WRITE_RATE_LIMIT_PER_MINUTE=60
ADMIN_FAILED_ATTEMPTS_PER_MINUTE=10
ADMIN_RATE_LIMIT_PER_MINUTE=120
POPULAR_QUERY_MIN_COUNT=5

# Phase 6: background sync and re-indexing
ARTIFACT_ROOT=../artifacts/index
BENCHMARK_DIR=../benchmark/v1
REINDEX_MAX_MRR_DROP=0.05
REINDEX_SMOKE_DOCUMENTS=10
JOB_SHUTDOWN_TIMEOUT_SECONDS=30

# Docker Compose (docker-compose.yml reads these from .env; every one has a local default)
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST_PORT=5433
API_HOST_PORT=8000
FRONTEND_HOST_PORT=8080
# Only for the very first start of a new environment; afterwards the API serves the version
# PostgreSQL marks active. A container path, for example /app/artifacts/index/idx-<version>:
ACTIVE_INDEX_PATH=
