# Copy to .env (gitignored). Placeholders only; never commit real values.
DATABASE_URL=postgresql+psycopg://polysearch:CHANGE_ME@localhost:5433/polysearch_dev
TEST_DATABASE_URL=postgresql+psycopg://polysearch:CHANGE_ME@localhost:5433/polysearch_test
WIKIPEDIA_USER_AGENT=PolySearch/0.1 (https://example.invalid/contact; you@example.invalid)
MAX_PAGES_PER_JOB=200

# Search API (run from backend/: uvicorn app.main:create_app --factory)
ACTIVE_INDEX_PATH=../artifacts/index/idx-REPLACE_WITH_VERSION
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
CURSOR_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
SEARCH_RATE_LIMIT_PER_MINUTE=30
TRUSTED_PROXY_IPS=[]
ANALYTICS_STORE_QUERY_TEXT=false
